# 4.8 House of Kuru: kings after the war

mbh:parikshit a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:later-kuru-kings ;
    skos:prefLabel "Parikshit"@en, "परीक्षित्"@sa-Deva, "Parīkṣit"@sa-Latn ;
    skos:hiddenLabel "Parikshita"@en, "Pariksit"@en ;
    skos:definition "Son of Abhimanyu and Uttara, born after the war and revived by Krishna after Ashwatthama's weapon had struck him in the womb; he succeeded Yudhishthira and died of the serpent Takshaka's bite."@en ;
    skos:note "A sage's son cursed him to die within seven days after he insulted the sage; Takshaka carried out the curse."@en ;
    mbhx:childOf mbh:abhimanyu, mbh:uttaraa ;
    mbhx:studentOf mbh:kripa ;
    mbhx:killedBy mbh:takshaka ;
    skos:exactMatch wd:Q2046277, dbr:Parikshit ;
    foaf:isPrimaryTopicOf wp:Parikshit .

mbh:janamejaya a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:later-kuru-kings ;
    skos:prefLabel "Janamejaya"@en, "जनमेजय"@sa-Deva, "Janamejaya"@sa-Latn ;
    skos:hiddenLabel "Janmejaya"@en, "Janmejay"@en ;
    skos:definition "Son of Parikshit, who held the snake sacrifice to avenge his father's death; the Mahabharata is recited to him there by Vaishampayana."@en ;
    skos:note "The sage Astika persuaded him to stop the sacrifice before Takshaka burned."@en ;
    mbhx:childOf mbh:parikshit ;
    skos:exactMatch wd:Q616654, dbr:Janamejaya ;
    foaf:isPrimaryTopicOf wp:Janamejaya .

# 4.9 Yadavas

mbh:krishna a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:yadavas, mbh:deities ;
    skos:prefLabel "Krishna"@en, "कृष्ण"@sa-Deva, "Kṛṣṇa"@sa-Latn ;
    skos:altLabel "Keshava"@en, "Madhava"@en, "Govinda"@en, "Hrishikesha"@en, "Janardana"@en, "Madhusudana"@en, "Achyuta"@en, "Parthasarathi"@en, "Varshneya"@en, "वासुदेव"@sa-Deva, "केशव"@sa-Deva, "माधव"@sa-Deva, "गोविन्द"@sa-Deva, "Vāsudeva"@sa-Latn, "Keśava"@sa-Latn, "Mādhava"@sa-Latn, "Govinda"@sa-Latn, "Hṛṣīkeśa"@sa-Latn, "Janārdana"@sa-Latn ;
    skos:hiddenLabel "Krishn"@en, "Krsna"@en, "Kanha"@en, "Shri Krishna"@en ;
    skos:definition "Prince of the Yadavas, son of Vasudeva, avatar of Vishnu, cousin and counsellor of the Pandavas and Arjuna's charioteer in the war, who speaks the Bhagavad Gita."@en ;
    skos:note "Kunti is his father's sister. He protected Draupadi at the dice game, killed Shishupala at Yudhishthira's consecration, went to Hastinapura as the Pandavas' envoy before the war, and cursed Ashwatthama after the night raid. Gandhari's curse brought the destruction of his clan thirty-six years after the war; he died when the hunter Jara's arrow struck his foot."@en ;
    mbhx:childOf mbh:vasudeva ;
    mbhx:avatarOf mbh:vishnu ;
    mbhx:charioteerOf mbh:arjuna ;
    mbhx:friendOf mbh:draupadi ;
    mbhx:cursed mbh:ashwatthama ;
    skos:exactMatch wd:Q42891, dbr:Krishna ;
    foaf:isPrimaryTopicOf wp:Krishna .

mbh:balarama a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:yadavas ;
    skos:prefLabel "Balarama"@en, "बलराम"@sa-Deva, "Balarāma"@sa-Latn ;
    skos:altLabel "Baladeva"@en, "Balabhadra"@en, "Halayudha"@en, "Sankarshana"@en, "Rauhineya"@en, "बलदेव"@sa-Deva, "Baladeva"@sa-Latn, "Halāyudha"@sa-Latn, "Saṅkarṣaṇa"@sa-Latn ;
    skos:hiddenLabel "Balram"@en, "Balaram"@en ;
    skos:definition "Elder brother of Krishna, son of Vasudeva and Rohini, who bears the plough as his weapon; he taught mace fighting to Duryodhana and Bhima and refused to fight in the war, leaving on pilgrimage instead."@en ;
    skos:note "He returned on the last day and objected to Bhima's blow below the waist in the duel with Duryodhana."@en ;
    mbhx:childOf mbh:vasudeva ;
    skos:exactMatch wd:Q1061606, dbr:Balarama ;
    foaf:isPrimaryTopicOf wp:Balarama .

mbh:vasudeva a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:yadavas ;
    skos:prefLabel "Vasudeva"@en, "वसुदेव"@sa-Deva, "Vasudeva"@sa-Latn ;
    skos:altLabel "Anakadundubhi"@en ;
    skos:definition "Yadava prince, son of Shurasena and brother of Kunti; father of Balarama, Krishna and Subhadra."@en ;
    skos:scopeNote "Distinct from Vāsudeva with a long first vowel, a patronymic name of Krishna."@en ;
    skos:exactMatch wd:Q890382, dbr:Vasudeva ;
    foaf:isPrimaryTopicOf wp:Vasudeva .

mbh:satyaki a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:yadavas ;
    skos:prefLabel "Satyaki"@en, "सात्यकि"@sa-Deva, "Sātyaki"@sa-Latn ;
    skos:altLabel "Yuyudhana"@en, "Shaineya"@en, "युयुधान"@sa-Deva, "Yuyudhāna"@sa-Latn, "Śaineya"@sa-Latn ;
    skos:hiddenLabel "Satyaki Yuyudhana"@en ;
    skos:definition "Vrishni warrior, grandson of Shini and student of Arjuna, who fought for the Pandavas and beheaded Bhurishravas while he sat in meditation after losing his arm; one of the survivors of the war."@en ;
    skos:note "He died in the brawl at Prabhasa that destroyed the Yadavas, after killing Kritavarma for his part in the night raid."@en ;
    mbhx:studentOf mbh:arjuna ;
    mbhx:rivalOf mbh:bhurishravas ;
    skos:exactMatch wd:Q2381158, dbr:Satyaki ;
    foaf:isPrimaryTopicOf wp:Satyaki .

mbh:kritavarma a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:yadavas ;
    skos:prefLabel "Kritavarma"@en, "कृतवर्मन्"@sa-Deva, "Kṛtavarman"@sa-Latn ;
    skos:altLabel "कृतवर्मा"@sa-Deva, "Kṛtavarmā"@sa-Latn ;
    skos:hiddenLabel "Kritavarman"@en, "Kritverma"@en ;
    skos:definition "Bhoja king of the Yadavas who fought for the Kauravas, took part with Ashwatthama and Kripa in the night raid on the Pandava camp, and survived the war; Satyaki killed him in the Yadava brawl at Prabhasa."@en ;
    mbhx:killedBy mbh:satyaki ;
    skos:exactMatch wd:Q2669309, dbr:Kritavarma ;
    foaf:isPrimaryTopicOf wp:Kritavarma .

mbh:kuntibhoja a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:yadavas ;
    skos:prefLabel "Kuntibhoja"@en, "कुन्तिभोज"@sa-Deva, "Kuntibhoja"@sa-Latn ;
    skos:hiddenLabel "Kunti-Bhoja"@en ;
    skos:definition "Childless cousin of Shurasena who adopted Shurasena's daughter Pritha, thereafter called Kunti; the sage Durvasa gave her the mantra for sons while a guest at his court."@en ;
    skos:exactMatch wd:Q4210132 ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/List_of_characters_in_the_Mahabharata> .

# 4.10 Royal house of Panchala

mbh:drupada a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:panchala ;
    skos:prefLabel "Drupada"@en, "द्रुपद"@sa-Deva, "Drupada"@sa-Latn ;
    skos:altLabel "Yajnasena"@en, "यज्ञसेन"@sa-Deva, "Yajñasena"@sa-Latn ;
    skos:hiddenLabel "Drupad"@en ;
    skos:definition "King of Panchala, Drona's boyhood friend and later his enemy, who held a sacrifice for a son to kill Drona and received Dhrishtadyumna and Draupadi from the fire; he fought for the Pandavas and was killed by Drona."@en ;
    skos:note "Drona had him defeated by his students and took half his kingdom in payment for a childhood insult."@en ;
    mbhx:rivalOf mbh:drona ;
    mbhx:killedBy mbh:drona ;
    mbhx:fellOnWarDay 15 ;
    skos:exactMatch wd:Q2389430, dbr:Drupada ;
    foaf:isPrimaryTopicOf wp:Drupada .

mbh:dhrishtadyumna a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:panchala ;
    skos:prefLabel "Dhrishtadyumna"@en, "धृष्टद्युम्न"@sa-Deva, "Dhṛṣṭadyumna"@sa-Latn ;
    skos:hiddenLabel "Dhrishtadyumn"@en, "Drishtadyumna"@en ;
    skos:definition "Son of Drupada born from the sacrificial fire to kill Drona, commander-in-chief of the Pandava army for the whole war; he beheaded Drona on day 15 and was killed by Ashwatthama in the night raid."@en ;
    mbhx:childOf mbh:drupada ;
    mbhx:killedBy mbh:ashwatthama ;
    mbhx:fellOnWarDay 18 ;
    skos:exactMatch wd:Q2357086, dbr:Dhrishtadyumna ;
    foaf:isPrimaryTopicOf wp:Dhrishtadyumna .

mbh:shikhandi a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:panchala ;
    skos:prefLabel "Shikhandi"@en, "शिखण्डिन्"@sa-Deva, "Śikhaṇḍin"@sa-Latn ;
    skos:altLabel "Shikhandini"@en, "शिखण्डी"@sa-Deva, "शिखण्डिनी"@sa-Deva, "Śikhaṇḍī"@sa-Latn, "Śikhaṇḍinī"@sa-Latn ;
    skos:hiddenLabel "Shikhandin"@en, "Sikhandi"@en ;
    skos:definition "Child of Drupada, born a girl as the rebirth of Amba and later made a man by exchanging sex with a yaksha; Bhishma refused to fight him, and Arjuna shot Bhishma down from behind him on day 10."@en ;
    skos:note "Killed by Ashwatthama in the night raid after the war."@en ;
    mbhx:childOf mbh:drupada ;
    mbhx:rebirthOf mbh:amba ;
    mbhx:killedBy mbh:ashwatthama ;
    mbhx:fellOnWarDay 18 ;
    skos:exactMatch wd:Q2357063, dbr:Shikhandi ;
    foaf:isPrimaryTopicOf wp:Shikhandi .

mbh:yudhamanyu a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:panchala ;
    skos:prefLabel "Yudhamanyu"@en, "युधामन्यु"@sa-Deva, "Yudhāmanyu"@sa-Latn ;
    skos:definition "Panchala prince who, with Uttamaujas, guarded the wheels of Arjuna's chariot through the war; killed by Ashwatthama in the night raid."@en ;
    mbhx:killedBy mbh:ashwatthama ;
    mbhx:fellOnWarDay 18 ;
    skos:closeMatch wd:Q15645224 ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/List_of_characters_in_the_Mahabharata> .

mbh:uttamaujas a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:panchala ;
    skos:prefLabel "Uttamaujas"@en, "उत्तमौजस्"@sa-Deva, "Uttamaujas"@sa-Latn ;
    skos:definition "Panchala prince who, with Yudhamanyu, guarded the wheels of Arjuna's chariot through the war; killed by Ashwatthama in the night raid."@en ;
    mbhx:killedBy mbh:ashwatthama ;
    mbhx:fellOnWarDay 18 ;
    skos:closeMatch wd:Q15645224 ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/List_of_characters_in_the_Mahabharata> .

# 4.11 Other royal houses

mbh:virata a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-matsya ;
    skos:prefLabel "Virata"@en, "विराट"@sa-Deva, "Virāṭa"@sa-Latn ;
    skos:hiddenLabel "Virat"@en ;
    skos:definition "King of Matsya, at whose court the Pandavas lived in disguise during the thirteenth year of exile; he fought for the Pandavas and was killed by Drona."@en ;
    mbhx:spouseOf mbh:sudeshna ;
    mbhx:killedBy mbh:drona ;
    mbhx:fellOnWarDay 15 ;
    skos:exactMatch wd:Q2978459, dbr:Virata ;
