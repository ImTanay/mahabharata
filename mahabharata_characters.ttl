    skos:hiddenLabel "Iravat"@en ;
    skos:definition "Son of Arjuna and the Naga Ulupi, who fought for the Pandavas and was killed by the rakshasa Alambusha on day 8."@en ;
    mbhx:childOf mbh:arjuna, mbh:ulupi ;
    mbhx:killedBy mbh:alambusha ;
