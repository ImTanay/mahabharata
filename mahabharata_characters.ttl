mbh:sudeshna a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-matsya ;
    skos:prefLabel "Sudeshna"@en, "सुदेष्णा"@sa-Deva, "Sudeṣṇā"@sa-Latn ;
    skos:definition "Queen of Matsya, wife of Virata and sister of Kichaka, who took Draupadi into her service as the maid Sairandhri."@en ;
    mbhx:siblingOf mbh:kichaka ;
    skos:exactMatch wd:Q15290894, dbr:Sudeshna ;
    foaf:isPrimaryTopicOf wp:Sudeshna .

mbh:kichaka a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-matsya ;
    skos:prefLabel "Kichaka"@en, "कीचक"@sa-Deva, "Kīcaka"@sa-Latn ;
    skos:hiddenLabel "Keechaka"@en, "Keechak"@en ;
    skos:definition "Commander of the Matsya army and brother of Queen Sudeshna, who pursued Draupadi during her disguise and was killed by Bhima in the dancing hall at night."@en ;
    mbhx:killedBy mbh:bhima ;
    skos:exactMatch wd:Q2382488, dbr:Kichaka ;
    foaf:isPrimaryTopicOf wp:Kichaka .

mbh:uttara a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-matsya ;
    skos:prefLabel "Uttara (prince of Matsya)"@en, "उत्तर"@sa-Deva, "Uttara"@sa-Latn ;
    skos:altLabel "Bhuminjaya"@en, "भूमिञ्जय"@sa-Deva, "Bhūmiñjaya"@sa-Latn ;
    skos:hiddenLabel "Uttar"@en, "Uttara Kumara"@en ;
    skos:definition "Prince of Matsya, son of Virata and Sudeshna, who drove Arjuna's chariot against the Kaurava cattle raid when Arjuna was still disguised as Brihannala; killed by Shalya on the first day of the war."@en ;
    mbhx:childOf mbh:virata, mbh:sudeshna ;
    mbhx:charioteerOf mbh:arjuna ;
    mbhx:killedBy mbh:shalya ;
    mbhx:fellOnWarDay 1 ;
    skos:exactMatch wd:Q4209828, <http://dbpedia.org/resource/Uttara_(Mahabharata)> ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Uttara_(Mahabharata)> .

mbh:uttaraa a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-matsya ;
    skos:prefLabel "Uttara (princess of Matsya)"@en, "उत्तरा"@sa-Deva, "Uttarā"@sa-Latn ;
    skos:hiddenLabel "Uttaraa"@en ;
    skos:definition "Princess of Matsya, daughter of Virata and Sudeshna, wife of Abhimanyu and mother of Parikshit, born after his father's death."@en ;
    mbhx:childOf mbh:virata, mbh:sudeshna ;
    skos:exactMatch wd:Q2389445, <http://dbpedia.org/resource/Uttarā> ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Uttarā> .

mbh:shalya a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-madra ;
    skos:prefLabel "Shalya"@en, "शल्य"@sa-Deva, "Śalya"@sa-Latn ;
    skos:hiddenLabel "Salya"@en, "Shalya of Madra"@en ;
    skos:definition "King of Madra, brother of Madri and uncle of Nakula and Sahadeva, whom Duryodhana won over with lavish hospitality on his way to join the Pandavas; he drove Karna's chariot and commanded the Kaurava army on the last day, when Yudhishthira killed him."@en ;
    mbhx:charioteerOf mbh:karna ;
    mbhx:killedBy mbh:yudhishthira ;
    mbhx:fellOnWarDay 18 ;
    skos:exactMatch wd:Q2381126, dbr:Shalya ;
    foaf:isPrimaryTopicOf wp:Shalya .

mbh:shakuni a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-gandhara ;
    skos:prefLabel "Shakuni"@en, "शकुनि"@sa-Deva, "Śakuni"@sa-Latn ;
    skos:altLabel "Saubala"@en, "सौबल"@sa-Deva, "Saubala"@sa-Latn ;
    skos:hiddenLabel "Sakuni"@en, "Shakuni Mama"@en ;
    skos:definition "Prince of Gandhara, son of Subala, brother of Gandhari and uncle of Duryodhana; he planned the house of lac and won the dice game for Duryodhana with loaded dice, and was killed by Sahadeva on the last day of the war."@en ;
    mbhx:killedBy mbh:sahadeva ;
    mbhx:fellOnWarDay 18 ;
    skos:exactMatch wd:Q1992668, dbr:Shakuni ;
    foaf:isPrimaryTopicOf wp:Shakuni .

mbh:uluka a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-gandhara ;
    skos:prefLabel "Uluka"@en, "उलूक"@sa-Deva, "Ulūka"@sa-Latn ;
    skos:definition "Son of Shakuni, sent by Duryodhana to the Pandava camp on the eve of the war to deliver his insults; killed by Sahadeva on the last day."@en ;
    mbhx:childOf mbh:shakuni ;
    mbhx:killedBy mbh:sahadeva ;
    mbhx:fellOnWarDay 18 ;
    skos:exactMatch wd:Q7880794, dbr:Uluka ;
    foaf:isPrimaryTopicOf wp:Uluka .

mbh:karna a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-anga, mbh:sutas ;
    skos:prefLabel "Karna"@en, "कर्ण"@sa-Deva, "Karṇa"@sa-Latn ;
    skos:altLabel "Radheya"@en, "Vasusena"@en, "Vaikartana"@en, "Sutaputra"@en, "Angaraja"@en, "राधेय"@sa-Deva, "वसुषेण"@sa-Deva, "Rādheya"@sa-Latn, "Vasuṣeṇa"@sa-Latn, "Vaikartana"@sa-Latn ;
    skos:hiddenLabel "Karn"@en, "Karnan"@en ;
    skos:definition "Son of Kunti by the sun god Surya, born before her marriage and set adrift; raised by the charioteer Adhiratha and his wife Radha, made king of Anga by Duryodhana, and the Pandavas' greatest opponent, killed by Arjuna on day 17."@en ;
    skos:note "He was born with armour and earrings that made him invulnerable, which he gave to Indra in exchange for a single-use spear; he spent the spear on Ghatotkacha. Parashurama taught him and then cursed him to forget the supreme weapon at the hour of need. He promised Kunti to spare all her sons but Arjuna. He commanded the Kaurava army on days 16 and 17 and died while lifting his chariot wheel from the mud."@en ;
    mbhx:childOf mbh:kunti, mbh:surya ;
    mbhx:fosterChildOf mbh:adhiratha, mbh:radha ;
    mbhx:studentOf mbh:drona, mbh:parashurama ;
    mbhx:killedBy mbh:arjuna ;
    mbhx:fellOnWarDay 17 ;
    skos:exactMatch wd:Q2727397, dbr:Karna ;
    foaf:isPrimaryTopicOf wp:Karna .

mbh:vrishasena a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-anga ;
    skos:prefLabel "Vrishasena"@en, "वृषसेन"@sa-Deva, "Vṛṣasena"@sa-Latn ;
    skos:definition "Eldest son of Karna, killed by Arjuna before his father's eyes on day 17."@en ;
    mbhx:childOf mbh:karna ;
    mbhx:killedBy mbh:arjuna ;
    mbhx:fellOnWarDay 17 ;
    skos:exactMatch wd:Q24054436, dbr:Vrishasena ;
    foaf:isPrimaryTopicOf wp:Vrishasena .

mbh:amba a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-kashi ;
    skos:prefLabel "Amba"@en, "अम्बा"@sa-Deva, "Ambā"@sa-Latn ;
    skos:definition "Eldest princess of Kashi, carried off by Bhishma, then rejected by the king of Shalva whom she loved and refused by Bhishma because of his vow; she vowed to cause Bhishma's death and was reborn as Shikhandi."@en ;
    skos:note "She sought Parashurama's help; his duel with Bhishma ended without a result."@en ;
    mbhx:rivalOf mbh:bhishma ;
    skos:exactMatch wd:Q2721773, <http://dbpedia.org/resource/Amba_(Mahabharata)> ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Amba_(Mahabharata)> .

mbh:jayadratha a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-sindhu ;
    skos:prefLabel "Jayadratha"@en, "जयद्रथ"@sa-Deva, "Jayadratha"@sa-Latn ;
    skos:hiddenLabel "Jayadrath"@en ;
    skos:definition "King of Sindhu and husband of Dussala, who abducted Draupadi during the exile and was spared; a boon from Shiva let him hold off four Pandavas on day 13 while Abhimanyu died, and Arjuna killed him at sunset on day 14."@en ;
    mbhx:spouseOf mbh:dussala ;
    mbhx:killedBy mbh:arjuna ;
    mbhx:fellOnWarDay 14 ;
    skos:exactMatch wd:Q2381146, dbr:Jayadratha ;
    foaf:isPrimaryTopicOf wp:Jayadratha .

mbh:jarasandha a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-magadha ;
    skos:prefLabel "Jarasandha"@en, "जरासन्ध"@sa-Deva, "Jarāsandha"@sa-Latn ;
    skos:hiddenLabel "Jarasandh"@en ;
    skos:definition "King of Magadha who imprisoned kings for a human sacrifice; Bhima killed him in a wrestling match on Krishna's advice, which freed the kings and opened the way to Yudhishthira's royal consecration."@en ;
    mbhx:killedBy mbh:bhima ;
    skos:exactMatch wd:Q2723062, dbr:Jarasandha ;
    foaf:isPrimaryTopicOf wp:Jarasandha .

mbh:shishupala a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-chedi ;
    skos:prefLabel "Shishupala"@en, "शिशुपाल"@sa-Deva, "Śiśupāla"@sa-Latn ;
    skos:hiddenLabel "Sisupala"@en, "Shishupal"@en ;
    skos:definition "King of Chedi and Krishna's cousin, who insulted Krishna at Yudhishthira's royal consecration until he exhausted the hundred insults Krishna had promised to forgive, and was killed with the discus."@en ;
    mbhx:killedBy mbh:krishna ;
    skos:exactMatch wd:Q2978464, dbr:Shishupala ;
    foaf:isPrimaryTopicOf wp:Shishupala .

mbh:dhrishtaketu a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-chedi ;
    skos:prefLabel "Dhrishtaketu"@en, "धृष्टकेतु"@sa-Deva, "Dhṛṣṭaketu"@sa-Latn ;
    skos:definition "King of Chedi after his father Shishupala, one of the seven commanders of the Pandava army; killed by Drona."@en ;
    mbhx:childOf mbh:shishupala ;
    mbhx:killedBy mbh:drona ;
    skos:exactMatch wd:Q135680081, dbr:Dhrishtaketu ;
    foaf:isPrimaryTopicOf wp:Dhrishtaketu .

mbh:bhagadatta a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-pragjyotisha ;
    skos:prefLabel "Bhagadatta"@en, "भगदत्त"@sa-Deva, "Bhagadatta"@sa-Latn ;
    skos:definition "Aged king of Pragjyotisha who fought for the Kauravas on his elephant Supratika; Arjuna killed him on day 12 after Krishna took Bhagadatta's Vaishnava weapon on his own chest."@en ;
    mbhx:killedBy mbh:arjuna ;
    mbhx:fellOnWarDay 12 ;
    skos:exactMatch wd:Q1114098, dbr:Bhagadatta ;
    foaf:isPrimaryTopicOf wp:Bhagadatta .

mbh:susharma a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-trigarta ;
    skos:prefLabel "Susharma"@en, "सुशर्मन्"@sa-Deva, "Suśarman"@sa-Latn ;
    skos:altLabel "सुशर्मा"@sa-Deva, "Suśarmā"@sa-Latn ;
    skos:hiddenLabel "Susharman"@en, "Sushurma"@en ;
    skos:definition "King of Trigarta who raided Virata's cattle and in the war led the Samsaptakas, sworn to kill Arjuna or die, to draw Arjuna away from the main battle; Arjuna killed him on day 18."@en ;
    mbhx:killedBy mbh:arjuna ;
    mbhx:fellOnWarDay 18 ;
    skos:exactMatch wd:Q25927082, dbr:Susharma ;
    foaf:isPrimaryTopicOf wp:Susharma .

mbh:sudakshina a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-kamboja ;
    skos:prefLabel "Sudakshina"@en, "सुदक्षिण"@sa-Deva, "Sudakṣiṇa"@sa-Latn ;
    skos:definition "King of the Kambojas who fought for the Kauravas; Arjuna killed him on day 14 on the way to Jayadratha."@en ;
    mbhx:killedBy mbh:arjuna ;
    mbhx:fellOnWarDay 14 ;
    skos:exactMatch wd:Q7633279, dbr:Sudakshina ;
    foaf:isPrimaryTopicOf wp:Sudakshina .

mbh:somadatta a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-bahlika ;
    skos:prefLabel "Somadatta"@en, "सोमदत्त"@sa-Deva, "Somadatta"@sa-Latn ;
    skos:definition "Son of Bahlika and father of Bhurishravas, who fought for the Kauravas and was killed by Satyaki on day 14."@en ;
    mbhx:childOf mbh:bahlika ;
    mbhx:killedBy mbh:satyaki ;
    mbhx:fellOnWarDay 14 ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/List_of_characters_in_the_Mahabharata> .

mbh:bhurishravas a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-bahlika ;
    skos:prefLabel "Bhurishravas"@en, "भूरिश्रवस्"@sa-Deva, "Bhūriśravas"@sa-Latn ;
    skos:altLabel "भूरिश्रवा"@sa-Deva, "Bhūriśravā"@sa-Latn ;
    skos:hiddenLabel "Bhurisravas"@en, "Bhurishrava"@en ;
    skos:definition "Son of Somadatta and grandson of Bahlika, who fought for the Kauravas and carried an old feud with Satyaki; on day 14 Arjuna cut off his arm as he was about to kill Satyaki, and Satyaki beheaded him as he sat in meditation."@en ;
    mbhx:childOf mbh:somadatta ;
    mbhx:killedBy mbh:satyaki ;
    mbhx:fellOnWarDay 14 ;
    skos:exactMatch wd:Q2724587, dbr:Bhurishravas ;
    foaf:isPrimaryTopicOf wp:Bhurishravas .

mbh:ekalavya a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-nishada ;
    skos:prefLabel "Ekalavya"@en, "एकलव्य"@sa-Deva, "Ekalavya"@sa-Latn ;
    skos:hiddenLabel "Eklavya"@en ;
    skos:definition "Nishada prince who taught himself archery before an image of Drona after Drona refused him; when Drona claimed his right thumb as a teacher's fee he gave it, and lost his skill. Krishna names him among those he killed."@en ;
    skos:scopeNote "Not linked to Drona by studentOf: Drona never taught him."@en ;
    mbhx:killedBy mbh:krishna ;
    skos:exactMatch wd:Q1987473, dbr:Ekalavya ;
    foaf:isPrimaryTopicOf wp:Ekalavya .

mbh:rukmi a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:kingdom-vidarbha ;
    skos:prefLabel "Rukmi"@en, "रुक्मिन्"@sa-Deva, "Rukmin"@sa-Latn ;
    skos:altLabel "रुक्मी"@sa-Deva, "Rukmī"@sa-Latn ;
    skos:hiddenLabel "Rukmin"@en ;
    skos:definition "King of Vidarbha and brother of Krishna's wife Rukmini, who offered his army to each side in turn with such boasting that both refused him; with Balarama he is one of the two warriors who took no part in the war."@en ;
    skos:exactMatch wd:Q2601106, dbr:Rukmi ;
    foaf:isPrimaryTopicOf wp:Rukmi .

# 4.12 Sages

mbh:vyasa a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:sages ;
    skos:prefLabel "Vyasa"@en, "व्यास"@sa-Deva, "Vyāsa"@sa-Latn ;
    skos:altLabel "Krishna Dvaipayana"@en, "Veda Vyasa"@en, "Badarayana"@en, "कृष्णद्वैपायन"@sa-Deva, "वेदव्यास"@sa-Deva, "Kṛṣṇa Dvaipāyana"@sa-Latn, "Vedavyāsa"@sa-Latn ;
    skos:hiddenLabel "Vyas"@en, "Ved Vyas"@en ;
    skos:definition "Sage, son of the sage Parashara and Satyavati, composer of the Mahabharata and a character in it: he fathers Dhritarashtra, Pandu and Vidura at Satyavati's request and returns at every turn of the story."@en ;
    skos:note "He gave Sanjaya the divine sight with which to narrate the war to Dhritarashtra. By a tradition recorded in the first book, Ganesha wrote the poem down as Vyasa dictated it. His disciple Vaishampayana recited it at Janamejaya's snake sacrifice."@en ;
    mbhx:childOf mbh:satyavati ;
    skos:exactMatch wd:Q330521, dbr:Vyasa ;
    foaf:isPrimaryTopicOf wp:Vyasa .

mbh:parashurama a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:sages ;
    skos:prefLabel "Parashurama"@en, "परशुराम"@sa-Deva, "Paraśurāma"@sa-Latn ;
    skos:altLabel "Bhargava Rama"@en, "Rama Jamadagnya"@en, "भार्गव"@sa-Deva, "Bhārgava"@sa-Latn, "Rāma Jāmadagnya"@sa-Latn ;
    skos:hiddenLabel "Parshuram"@en, "Parasurama"@en ;
    skos:definition "Warrior sage with the axe, sixth avatar of Vishnu, teacher of Bhishma, Drona and Karna; he fought Bhishma for Amba's sake without result and cursed Karna, who had hidden his birth from him."@en ;
    mbhx:avatarOf mbh:vishnu ;
    mbhx:cursed mbh:karna ;
    skos:exactMatch wd:Q825682, dbr:Parashurama ;
    foaf:isPrimaryTopicOf wp:Parashurama .

mbh:narada a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:sages ;
    skos:prefLabel "Narada"@en, "नारद"@sa-Deva, "Nārada"@sa-Latn ;
    skos:hiddenLabel "Narad"@en, "Narada Muni"@en ;
    skos:definition "Divine sage who moves between gods and men; he told the Pandavas the story of the brothers Sunda and Upasunda so that they would agree on rules for sharing Draupadi, and advised Yudhishthira on the royal consecration."@en ;
    skos:exactMatch wd:Q844066, dbr:Narada ;
    foaf:isPrimaryTopicOf wp:Narada .

mbh:durvasa a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:sages ;
    skos:prefLabel "Durvasa"@en, "दुर्वासस्"@sa-Deva, "Durvāsas"@sa-Latn ;
    skos:altLabel "दुर्वासा"@sa-Deva, "Durvāsā"@sa-Latn ;
    skos:hiddenLabel "Durvasas"@en, "Durvasa Muni"@en ;
    skos:definition "Short-tempered sage who, pleased with the young Kunti's service, gave her the mantra to summon any god for a son; Duryodhana later sent him with his disciples to the Pandavas in exile hoping he would curse them."@en ;
    skos:note "Krishna satisfied the sage's hunger with the one grain of rice left in Draupadi's vessel."@en ;
    skos:exactMatch wd:Q2361344, dbr:Durvasa ;
    foaf:isPrimaryTopicOf wp:Durvasa .

mbh:markandeya a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:sages ;
    skos:prefLabel "Markandeya"@en, "मार्कण्डेय"@sa-Deva, "Mārkaṇḍeya"@sa-Latn ;
    skos:hiddenLabel "Markandey"@en ;
    skos:definition "Long-lived sage who visits the Pandavas in the forest and tells them the stories of Rama, of Savitri and of the ages of the world."@en ;
    skos:exactMatch wd:Q249381, dbr:Markandeya ;
    foaf:isPrimaryTopicOf wp:Markandeya .

mbh:dhaumya a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:sages ;
    skos:prefLabel "Dhaumya"@en, "धौम्य"@sa-Deva, "Dhaumya"@sa-Latn ;
    skos:altLabel "Ayoda Dhaumya"@en ;
    skos:definition "Family priest of the Pandavas, who conducted their marriage to Draupadi and went with them into exile."@en ;
    skos:exactMatch wd:Q12434693, dbr:Dhaumya ;
    foaf:isPrimaryTopicOf wp:Dhaumya .

mbh:vaishampayana a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:sages ;
    skos:prefLabel "Vaishampayana"@en, "वैशम्पायन"@sa-Deva, "Vaiśampāyana"@sa-Latn ;
    skos:hiddenLabel "Vaisampayana"@en, "Vaishampayan"@en ;
    skos:definition "Disciple of Vyasa who recited the Mahabharata to King Janamejaya at the snake sacrifice; the inner frame of the epic's narration."@en ;
    mbhx:studentOf mbh:vyasa ;
    skos:exactMatch wd:Q2477603, dbr:Vaisampayana ;
    foaf:isPrimaryTopicOf wp:Vaisampayana .

mbh:shaunaka a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:sages ;
    skos:prefLabel "Shaunaka"@en, "शौनक"@sa-Deva, "Śaunaka"@sa-Latn ;
    skos:hiddenLabel "Saunaka"@en ;
    skos:definition "Head of the sages at the twelve-year sacrifice in the Naimisha forest, to whom the bard Ugrashravas recites the epic as he heard it at Janamejaya's sacrifice; the outer frame of the narration."@en ;
    skos:exactMatch wd:Q2073479, dbr:Shaunaka ;
    foaf:isPrimaryTopicOf wp:Shaunaka .

mbh:astika a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:sages ;
    skos:prefLabel "Astika"@en, "आस्तीक"@sa-Deva, "Āstīka"@sa-Latn ;
    skos:hiddenLabel "Aastika"@en, "Astik"@en ;
    skos:definition "Young sage, son of the ascetic Jaratkaru and the serpent king Vasuki's sister, who persuaded Janamejaya to end the snake sacrifice and so saved Takshaka and the Nagas."@en ;
    skos:exactMatch wd:Q3595632, <http://dbpedia.org/resource/Astika_(sage)> ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Astika_(sage)> .

# 4.13 Brahmin warriors of the Kuru court

mbh:drona a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:warrior-brahmins ;
    skos:prefLabel "Drona"@en, "द्रोण"@sa-Deva, "Droṇa"@sa-Latn ;
    skos:altLabel "Dronacharya"@en, "Bharadvaja (patronymic of Drona)"@en, "द्रोणाचार्य"@sa-Deva, "Droṇācārya"@sa-Latn ;
    skos:hiddenLabel "Dron"@en, "Guru Drona"@en ;
    skos:definition "Brahmin master of arms, son of the sage Bharadvaja, husband of Kripi and father of Ashwatthama; teacher of the Pandavas and Kauravas, commander of the Kaurava army for days 11 to 15, beheaded by Dhrishtadyumna."@en ;
    skos:note "He learnt weapons from Parashurama. Humiliated by his boyhood friend Drupada, he had his students conquer Panchala. He demanded Ekalavya's thumb. He laid down his weapons on hearing the false report that Ashwatthama was dead, and Dhrishtadyumna killed him as he sat in meditation."@en ;
    mbhx:spouseOf mbh:kripi ;
    mbhx:studentOf mbh:parashurama ;
    mbhx:killedBy mbh:dhrishtadyumna ;
    mbhx:fellOnWarDay 15 ;
    skos:exactMatch wd:Q890529, dbr:Drona ;
    foaf:isPrimaryTopicOf wp:Drona .

mbh:kripa a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:warrior-brahmins ;
    skos:prefLabel "Kripa"@en, "कृप"@sa-Deva, "Kṛpa"@sa-Latn ;
    skos:altLabel "Kripacharya"@en, "Sharadvata"@en, "कृपाचार्य"@sa-Deva, "Kṛpācārya"@sa-Latn, "Śāradvata"@sa-Latn ;
    skos:hiddenLabel "Krupa"@en, "Kripacharya Sharadvan"@en ;
    skos:definition "Son of the sage Sharadvan, raised at Shantanu's court with his sister Kripi; first teacher of the Kuru princes, who fought for the Kauravas, survived the war with Ashwatthama and Kritavarma, and later taught Parikshit."@en ;
    skos:note "Counted among the immortals (chiranjivis)."@en ;
    mbhx:siblingOf mbh:kripi ;
    skos:exactMatch wd:Q2044671, dbr:Kripa ;
    foaf:isPrimaryTopicOf wp:Kripa .

mbh:kripi a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:warrior-brahmins ;
    skos:prefLabel "Kripi"@en, "कृपी"@sa-Deva, "Kṛpī"@sa-Latn ;
    skos:definition "Sister of Kripa, wife of Drona and mother of Ashwatthama."@en ;
    skos:exactMatch wd:Q106948922 ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/List_of_characters_in_the_Mahabharata> .

mbh:ashwatthama a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:warrior-brahmins ;
    skos:prefLabel "Ashwatthama"@en, "अश्वत्थामन्"@sa-Deva, "Aśvatthāman"@sa-Latn ;
    skos:altLabel "Drauni"@en, "अश्वत्थामा"@sa-Deva, "द्रौणि"@sa-Deva, "Aśvatthāmā"@sa-Latn, "Drauṇi"@sa-Latn ;
    skos:hiddenLabel "Ashvatthama"@en, "Ashwathama"@en, "Ashwatthaman"@en, "Aswatthama"@en ;
    skos:definition "Son of Drona and Kripi, born with a gem in his forehead, who fought for the Kauravas; after Duryodhana fell he raided the sleeping Pandava camp by night and killed Dhrishtadyumna, Shikhandi and the five sons of Draupadi, then loosed a weapon at the unborn Parikshit."@en ;
    skos:note "Duryodhana made him the last Kaurava commander on the night of day 18. Krishna cursed him to wander the earth for three thousand years, bleeding and alone, and took the gem from his forehead. Counted among the immortals (chiranjivis)."@en ;
    mbhx:childOf mbh:drona, mbh:kripi ;
    mbhx:studentOf mbh:drona ;
    skos:exactMatch wd:Q2044550, dbr:Ashvatthama ;
    foaf:isPrimaryTopicOf wp:Ashvatthama .

# 4.14 Sutas

mbh:sanjaya a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:sutas ;
    skos:prefLabel "Sanjaya"@en, "सञ्जय"@sa-Deva, "Sañjaya"@sa-Latn ;
    skos:altLabel "Gavalgani"@en, "Gāvalgaṇi"@sa-Latn ;
    skos:hiddenLabel "Sanjay"@en ;
    skos:definition "Son of Gavalgana, charioteer, minister and envoy of Dhritarashtra, to whom he narrates the eighteen days of the war with the divine sight Vyasa granted him; the Bhagavad Gita reaches the reader in his words."@en ;
    skos:note "Before the war he carried Dhritarashtra's message to the Pandavas. Satyaki captured him on the last day and Vyasa secured his release. He went with Dhritarashtra into the forest and survived the fire."@en ;
    mbhx:charioteerOf mbh:dhritarashtra ;
    skos:exactMatch wd:Q2389469, dbr:Sanjaya ;
    foaf:isPrimaryTopicOf wp:Sanjaya .

mbh:ugrashravas a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:sutas ;
    skos:prefLabel "Ugrashravas"@en, "उग्रश्रवस्"@sa-Deva, "Ugraśravas"@sa-Latn ;
    skos:altLabel "Sauti"@en, "Ugrashravas Sauti"@en, "सौति"@sa-Deva, "Sauti"@sa-Latn ;
    skos:hiddenLabel "Ugrasrava"@en, "Ugrasravas"@en, "Souti"@en ;
    skos:definition "Bard, son of the suta Lomaharshana, who recites the whole Mahabharata to Shaunaka and the sages of the Naimisha forest as he heard it from Vaishampayana at Janamejaya's sacrifice; the outermost narrator of the epic."@en ;
    skos:exactMatch wd:Q2075682, dbr:Ugrashravas ;
    foaf:isPrimaryTopicOf wp:Ugrashravas .

mbh:adhiratha a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:sutas ;
    skos:prefLabel "Adhiratha"@en, "अधिरथ"@sa-Deva, "Adhiratha"@sa-Latn ;
    skos:hiddenLabel "Adiratha"@en, "Adhirath"@en ;
    skos:definition "Charioteer of Dhritarashtra and husband of Radha, who found the infant Karna floating in a basket on the river and raised him as his son."@en ;
    mbhx:spouseOf mbh:radha ;
    mbhx:charioteerOf mbh:dhritarashtra ;
    skos:exactMatch wd:Q2472652 ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/List_of_characters_in_the_Mahabharata> .

mbh:radha a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:sutas ;
    skos:prefLabel "Radha (foster mother of Karna)"@en, "राधा"@sa-Deva, "Rādhā"@sa-Latn ;
    skos:definition "Wife of the charioteer Adhiratha and foster mother of Karna, who is called Radheya after her."@en ;
    skos:scopeNote "Not the Radha of the Krishna legends, who does not appear in the Mahabharata."@en ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/List_of_characters_in_the_Mahabharata> .

# 4.15 Deities and celestial beings

mbh:vishnu a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:deities ;
    skos:prefLabel "Vishnu"@en, "विष्णु"@sa-Deva, "Viṣṇu"@sa-Latn ;
    skos:altLabel "Narayana"@en, "Hari"@en, "नारायण"@sa-Deva, "Nārāyaṇa"@sa-Latn ;
    skos:hiddenLabel "Visnu"@en, "Bishnu"@en ;
    skos:definition "The preserver god, present in the epic through his avatars Krishna and Parashurama and invoked as Narayana."@en ;
    skos:exactMatch wd:Q11380, dbr:Vishnu ;
    foaf:isPrimaryTopicOf wp:Vishnu .

mbh:shiva a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:deities ;
    skos:prefLabel "Shiva"@en, "शिव"@sa-Deva, "Śiva"@sa-Latn ;
    skos:altLabel "Mahadeva"@en, "Rudra"@en, "Shankara"@en, "महादेव"@sa-Deva, "Mahādeva"@sa-Latn, "Rudra"@sa-Latn ;
    skos:hiddenLabel "Siva"@en, "Shiv"@en ;
    skos:definition "God who tests Arjuna in the form of a mountain hunter and gives him the Pashupata weapon, grants Jayadratha the boon that holds the Pandavas back on day 13, grants Amba the promise of her revenge, and lends Ashwatthama his power for the night raid."@en ;
    skos:exactMatch wd:Q11378, dbr:Shiva ;
    foaf:isPrimaryTopicOf wp:Shiva .

mbh:indra a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:deities ;
    skos:prefLabel "Indra"@en, "इन्द्र"@sa-Deva, "Indra"@sa-Latn ;
    skos:altLabel "Shakra"@en, "Vasava"@en, "Purandara"@en, "शक्र"@sa-Deva, "Śakra"@sa-Latn, "Vāsava"@sa-Latn ;
    skos:definition "King of the gods and father of Arjuna, whom he hosts in heaven during the exile; disguised as a Brahmin he takes Karna's armour and earrings in exchange for a spear that can be used only once."@en ;
    skos:note "He fought Arjuna and Krishna at the burning of the Khandava forest to protect his friend Takshaka's home. The Pandavas' capital Indraprastha is named after him."@en ;
    skos:exactMatch wd:Q128335, dbr:Indra ;
    foaf:isPrimaryTopicOf wp:Indra .

mbh:surya a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:deities ;
    skos:prefLabel "Surya"@en, "सूर्य"@sa-Deva, "Sūrya"@sa-Latn ;
    skos:altLabel "Aditya"@en, "Vivasvan"@en, "आदित्य"@sa-Deva, "Āditya"@sa-Latn ;
    skos:definition "The sun god, father of Karna by Kunti, who gave Yudhishthira the inexhaustible vessel for the exile and warned Karna of Indra's trick."@en ;
    skos:exactMatch wd:Q204418, dbr:Surya ;
    foaf:isPrimaryTopicOf wp:Surya .

mbh:vayu a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:deities ;
    skos:prefLabel "Vayu"@en, "वायु"@sa-Deva, "Vāyu"@sa-Latn ;
    skos:altLabel "Pavana"@en, "Maruta"@en, "पवन"@sa-Deva, "Pavana"@sa-Latn ;
    skos:definition "The wind god, father of Bhima by Kunti and of Hanuman."@en ;
    skos:exactMatch wd:Q473731, dbr:Vayu ;
    foaf:isPrimaryTopicOf wp:Vayu .

mbh:dharma a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:deities ;
    skos:prefLabel "Dharma"@en, "धर्म"@sa-Deva, "Dharma"@sa-Latn ;
    skos:altLabel "Yama"@en, "Dharmadeva"@en, "Yama Dharmaraja"@en, "यम"@sa-Deva, "Yama"@sa-Latn, "Dharmadeva"@sa-Latn ;
    skos:definition "God of righteousness, identified with Yama, the lord of the dead; father of Yudhishthira by Kunti, incarnate in Vidura, and the tester of Yudhishthira as the Yaksha at the lake and as the dog on the final journey."@en ;
    skos:scopeNote "The Wikipedia synopsis names the father of Yudhishthira as Dharma and the dog as Yama. This scheme treats them as one being, as the epic does, and maps the concept to Yama with closeMatch because the Wikidata item covers Yama in all his roles."@en ;
    skos:closeMatch wd:Q45097, dbr:Yama ;
    rdfs:seeAlso wp:Yama .

mbh:ashvins a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:deities ;
    skos:prefLabel "Ashvins"@en, "अश्विनौ"@sa-Deva, "Aśvinau"@sa-Latn ;
    skos:altLabel "Ashwini Kumaras"@en, "Nasatya and Dasra"@en, "अश्विनीकुमार"@sa-Deva, "Nāsatya"@sa-Latn, "Dasra"@sa-Latn ;
    skos:hiddenLabel "Ashwins"@en, "Asvins"@en ;
    skos:definition "The twin horse-headed gods of healing, fathers of the twins Nakula and Sahadeva by Madri."@en ;
    skos:scopeNote "Modelled as one concept because the epic treats the twins as a pair in this role."@en ;
    skos:exactMatch wd:Q726593, dbr:Ashvins ;
    foaf:isPrimaryTopicOf wp:Ashvins .

mbh:agni a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:deities ;
    skos:prefLabel "Agni"@en, "अग्नि"@sa-Deva, "Agni"@sa-Latn ;
    skos:altLabel "Vahni"@en, "Hutashana"@en, "Vahni"@sa-Latn ;
    skos:definition "The fire god, who asked Arjuna and Krishna to let him consume the Khandava forest and rewarded them with the bow Gandiva, Arjuna's chariot and inexhaustible quivers, and Krishna's discus."@en ;
    skos:exactMatch wd:Q394867, dbr:Agni ;
    foaf:isPrimaryTopicOf wp:Agni .

mbh:ganga a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:deities ;
    skos:prefLabel "Ganga"@en, "गङ्गा"@sa-Deva, "Gaṅgā"@sa-Latn ;
    skos:altLabel "Jahnavi"@en, "Bhagirathi"@en, "Jāhnavī"@sa-Latn, "Bhāgīrathī"@sa-Latn ;
    skos:hiddenLabel "Ganges"@en, "Ganga Devi"@en ;
    skos:definition "The river goddess, first wife of Shantanu and mother of Bhishma, whom she raised and had taught before returning him to his father."@en ;
    skos:exactMatch wd:Q580113, <http://dbpedia.org/resource/Ganga_(goddess)> ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Ganga_(goddess)> .

mbh:ganesha a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:deities ;
    skos:prefLabel "Ganesha"@en, "गणेश"@sa-Deva, "Gaṇeśa"@sa-Latn ;
    skos:altLabel "Ganapati"@en, "Vinayaka"@en, "गणपति"@sa-Deva, "Gaṇapati"@sa-Latn, "Vināyaka"@sa-Latn ;
    skos:hiddenLabel "Ganesh"@en, "Ganapathi"@en ;
    skos:definition "The elephant-headed god who, in a tradition recorded in the first book of the epic, wrote the Mahabharata down as Vyasa dictated it, on condition that Vyasa never pause."@en ;
    skos:exactMatch wd:Q1579, dbr:Ganesha ;
    foaf:isPrimaryTopicOf wp:Ganesha .

mbh:hanuman a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:deities ;
    skos:prefLabel "Hanuman"@en, "हनुमत्"@sa-Deva, "Hanumat"@sa-Latn ;
    skos:altLabel "Maruti"@en, "Anjaneya"@en, "हनुमान्"@sa-Deva, "Hanumān"@sa-Latn, "Māruti"@sa-Latn, "Āñjaneya"@sa-Latn ;
    skos:hiddenLabel "Hanumaan"@en, "Hanumanta"@en ;
    skos:definition "The monkey god of the Ramayana, son of Vayu and so brother of Bhima; he humbles Bhima in the forest by asking him to lift his tail, and rides on Arjuna's banner through the war."@en ;
    skos:note "Counted among the immortals (chiranjivis)."@en ;
    mbhx:childOf mbh:vayu ;
    skos:exactMatch wd:Q188618, dbr:Hanuman ;
    foaf:isPrimaryTopicOf wp:Hanuman .

mbh:urvashi a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:deities ;
    skos:prefLabel "Urvashi"@en, "उर्वशी"@sa-Deva, "Urvaśī"@sa-Latn ;
    skos:hiddenLabel "Urvasi"@en ;
    skos:definition "Celestial nymph who desired Arjuna in Indra's heaven; when he refused her as an ancestress of his line she cursed him to lose his manhood, a curse Indra reduced to the one year Arjuna spent as Brihannala."@en ;
    mbhx:cursed mbh:arjuna ;
    skos:exactMatch wd:Q2307799, dbr:Urvashi ;
    foaf:isPrimaryTopicOf wp:Urvashi .

# 4.16 Rakshasas, Nagas and Asuras

mbh:hidimba a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:rakshasas ;
    skos:prefLabel "Hidimba"@en, "हिडिम्ब"@sa-Deva, "Hiḍimba"@sa-Latn ;
    skos:hiddenLabel "Hidimb"@en, "Hidimbasura"@en ;
    skos:definition "Man-eating rakshasa of the forest the Pandavas entered after the house of lac; he sent his sister Hidimbi to fetch the sleepers and was killed by Bhima when she fell in love with him instead."@en ;
    mbhx:killedBy mbh:bhima ;
    skos:exactMatch wd:Q122430, dbr:Hidimba ;
    foaf:isPrimaryTopicOf wp:Hidimba .

mbh:bakasura a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:rakshasas ;
    skos:prefLabel "Bakasura"@en, "बकासुर"@sa-Deva, "Bakāsura"@sa-Latn ;
    skos:altLabel "Baka"@en, "बक"@sa-Deva, "Baka"@sa-Latn ;
    skos:hiddenLabel "Vakasura"@en, "Bakasur"@en ;
    skos:definition "Rakshasa who exacted a cartload of food and a human being from the town of Ekachakra every day; Bhima took the place of the Brahmin family's victim and killed him."@en ;
    mbhx:siblingOf mbh:kirmira ;
    mbhx:killedBy mbh:bhima ;
    skos:exactMatch wd:Q2724067, dbr:Bakasura ;
    foaf:isPrimaryTopicOf wp:Bakasura .

mbh:kirmira a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:rakshasas ;
    skos:prefLabel "Kirmira"@en, "किर्मीर"@sa-Deva, "Kirmīra"@sa-Latn ;
    skos:hiddenLabel "Kirmeera"@en ;
    skos:definition "Rakshasa of the Kamyaka forest, brother of Bakasura and friend of Hidimba, who sought revenge on Bhima at the start of the exile and was killed by him."@en ;
    mbhx:killedBy mbh:bhima ;
    skos:exactMatch wd:Q6415922, dbr:Kirmira ;
    foaf:isPrimaryTopicOf wp:Kirmira .

mbh:jatasura a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:rakshasas ;
    skos:prefLabel "Jatasura"@en, "जटासुर"@sa-Deva, "Jaṭāsura"@sa-Latn ;
    skos:hiddenLabel "Jatasur"@en ;
    skos:definition "Rakshasa who lived with the Pandavas in exile disguised as a Brahmin, carried off Draupadi, Yudhishthira and the twins while Bhima was away, and was killed by Bhima."@en ;
    mbhx:killedBy mbh:bhima ;
    skos:exactMatch wd:Q6164511, dbr:Jatasura ;
    foaf:isPrimaryTopicOf wp:Jatasura .

mbh:alambusha a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:rakshasas ;
    skos:prefLabel "Alambusha"@en, "अलम्बुष"@sa-Deva, "Alambuṣa"@sa-Latn ;
    skos:hiddenLabel "Alambush"@en, "Alamvusha"@en ;
    skos:definition "Rakshasa who fought for the Kauravas, killed Iravan on day 8 and was killed by Ghatotkacha in the night battle of day 14."@en ;
    mbhx:killedBy mbh:ghatotkacha ;
    mbhx:fellOnWarDay 14 ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/List_of_characters_in_the_Mahabharata> .

mbh:takshaka a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:nagas ;
    skos:prefLabel "Takshaka"@en, "तक्षक"@sa-Deva, "Takṣaka"@sa-Latn ;
    skos:hiddenLabel "Taksaka"@en, "Takshak"@en ;
    skos:definition "Serpent king and friend of Indra, who lived in the Khandava forest before Arjuna burned it; he killed Parikshit to fulfil a sage's curse, and Astika saved him from Janamejaya's snake sacrifice."@en ;
    skos:exactMatch wd:Q2633766, dbr:Takshaka ;
    foaf:isPrimaryTopicOf wp:Takshaka .

mbh:maya a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:asuras ;
    skos:prefLabel "Maya"@en, "मय"@sa-Deva, "Maya"@sa-Latn ;
    skos:altLabel "Mayasura"@en, "Maya Danava"@en, "मयासुर"@sa-Deva, "Mayāsura"@sa-Latn ;
    skos:hiddenLabel "Maya the architect"@en ;
    skos:definition "Architect of the Danavas, spared by Arjuna at the burning of the Khandava forest, who built the Pandavas' assembly hall at Indraprastha in gratitude; Duryodhana's humiliation in that hall led to the dice game."@en ;
    skos:exactMatch wd:Q2723049, dbr:Mayasura ;
    foaf:isPrimaryTopicOf wp:Mayasura .

# ---------------------------------------------------------------------------
# 5. Collections
# ---------------------------------------------------------------------------
# Ordered collections state both skos:memberList and skos:member, so that a
# consumer without SKOS inference sees the membership (S35 entails it).

mbh:coll-pandavas-by-birth a skos:OrderedCollection ;
    skos:inScheme mb:characters ;
    skos:prefLabel "The five Pandavas in order of birth"@en ;
    skos:definition "Yudhishthira, Bhima, Arjuna, Nakula and Sahadeva, eldest first. The twins Nakula and Sahadeva are born together; the epic names Nakula first."@en ;
    skos:memberList ( mbh:yudhishthira mbh:bhima mbh:arjuna mbh:nakula mbh:sahadeva ) ;
    skos:member mbh:yudhishthira, mbh:bhima, mbh:arjuna, mbh:nakula, mbh:sahadeva .

mbh:coll-upapandavas-by-father a skos:OrderedCollection ;
    skos:inScheme mb:characters ;
    skos:prefLabel "The sons of Draupadi in the order of their fathers' birth"@en ;
    skos:definition "Prativindhya (by Yudhishthira), Sutasoma (Bhima), Shrutakarma (Arjuna), Shatanika (Nakula) and Shrutasena (Sahadeva)."@en ;
    skos:memberList ( mbh:prativindhya mbh:sutasoma mbh:shrutakarma mbh:shatanika mbh:shrutasena ) ;
    skos:member mbh:prativindhya, mbh:sutasoma, mbh:shrutakarma, mbh:shatanika, mbh:shrutasena .

mbh:coll-kaurava-commanders a skos:OrderedCollection ;
    skos:inScheme mb:characters ;
    skos:prefLabel "Commanders-in-chief of the Kaurava army, in sequence"@en ;
    skos:definition "Bhishma (days 1 to 10), Drona (days 11 to 15), Karna (days 16 and 17), Shalya (day 18) and Ashwatthama (the night after day 18). Dhrishtadyumna commanded the Pandava army throughout."@en ;
    skos:memberList ( mbh:bhishma mbh:drona mbh:karna mbh:shalya mbh:ashwatthama ) ;
    skos:member mbh:bhishma, mbh:drona, mbh:karna, mbh:shalya, mbh:ashwatthama .

mbh:coll-children-of-kunti a skos:Collection ;
    skos:inScheme mb:characters ;
    skos:prefLabel "Children of Kunti"@en ;
    skos:altLabel "Kaunteyas"@en ;
    skos:definition "Kunti's four sons: Karna, born before her marriage and raised by others, and the three elder Pandavas. Karna learns of the kinship only from Krishna and Kunti before the war."@en ;
    skos:member mbh:karna, mbh:yudhishthira, mbh:bhima, mbh:arjuna .

mbh:coll-pandava-side a skos:Collection ;
    skos:inScheme mb:characters ;
    skos:prefLabel "Kurukshetra war: the Pandava side"@en ;
    skos:definition "Characters in this scheme who took the field for the Pandavas, and Krishna, who served as Arjuna's charioteer without fighting."@en ;
    skos:member mbh:yudhishthira, mbh:bhima, mbh:arjuna, mbh:nakula, mbh:sahadeva, mbh:krishna,
                mbh:abhimanyu, mbh:ghatotkacha, mbh:iravan,
                mbh:prativindhya, mbh:sutasoma, mbh:shrutakarma, mbh:shatanika, mbh:shrutasena,
                mbh:satyaki, mbh:drupada, mbh:dhrishtadyumna, mbh:shikhandi, mbh:yudhamanyu, mbh:uttamaujas,
                mbh:virata, mbh:uttara, mbh:dhrishtaketu, mbh:yuyutsu .

mbh:coll-kaurava-side a skos:Collection ;
    skos:inScheme mb:characters ;
    skos:prefLabel "Kurukshetra war: the Kaurava side"@en ;
    skos:definition "Characters in this scheme who took the field for Duryodhana."@en ;
    skos:member mbh:duryodhana, mbh:dushasana, mbh:vikarna, mbh:lakshmana-kumara, mbh:durmasena,
                mbh:bhishma, mbh:drona, mbh:kripa, mbh:ashwatthama,
                mbh:karna, mbh:vrishasena, mbh:shalya, mbh:shakuni, mbh:uluka,
                mbh:jayadratha, mbh:bhagadatta, mbh:susharma, mbh:sudakshina,
                mbh:bahlika, mbh:somadatta, mbh:bhurishravas, mbh:kritavarma, mbh:alambusha .

mbh:coll-stayed-out a skos:Collection ;
    skos:inScheme mb:characters ;
    skos:prefLabel "Warriors who took no part in the war"@en ;
    skos:definition "Balarama, who left on pilgrimage rather than fight his students on both sides, and Rukmi, whom both sides refused."@en ;
    skos:member mbh:balarama, mbh:rukmi .

mbh:coll-survivors a skos:Collection ;
    skos:inScheme mb:characters ;
    skos:prefLabel "Survivors of the Kurukshetra war"@en ;
    skos:definition "The combatants alive at the end of the eighteen days, as the Wikipedia synopsis lists them: the five Pandavas, Satyaki, Kripa, Ashwatthama, Kritavarma, Yuyutsu and Krishna."@en ;
    skos:member mbh:yudhishthira, mbh:bhima, mbh:arjuna, mbh:nakula, mbh:sahadeva,
                mbh:krishna, mbh:satyaki, mbh:yuyutsu, mbh:ashwatthama, mbh:kripa, mbh:kritavarma .

mbh:coll-narrative-frame a skos:Collection ;
    skos:inScheme mb:characters ;
    skos:prefLabel "The narrative frame of the Mahabharata"@en ;
    skos:definition "The tellers and hearers through whom the epic reaches the reader. Outer frame: the bard Ugrashravas recites to Shaunaka and the sages of the Naimisha forest. Inner frame: Vaishampayana recites to Janamejaya at the snake sacrifice. Composition: Vyasa, with Ganesha as scribe in one tradition. Within the story: Sanjaya narrates the war to Dhritarashtra."@en ;
    skos:member mbh:ugrashravas, mbh:shaunaka, mbh:vaishampayana, mbh:janamejaya,
                mbh:vyasa, mbh:ganesha, mbh:sanjaya, mbh:dhritarashtra .

mbh:coll-chiranjivis a skos:Collection ;
    skos:inScheme mb:characters ;
    skos:prefLabel "Immortals (chiranjivis) among the characters"@en ;
    skos:altLabel "Chiranjivis"@en ;
    skos:definition "Characters in this scheme whom Hindu tradition counts among the seven immortals: Ashwatthama, Kripa, Vyasa, Parashurama and Hanuman."@en ;
    skos:member mbh:ashwatthama, mbh:kripa, mbh:vyasa, mbh:parashurama, mbh:hanuman .

mbh:coll-virata-disguises a skos:Collection ;
    skos:inScheme mb:characters ;
    skos:prefLabel "The disguises at Virata's court"@en ;
    skos:definition "The six who spent the thirteenth year of exile at the court of Matsya under assumed names: Yudhishthira as the courtier Kanka, Bhima as the cook Vallabha, Arjuna as the dance teacher Brihannala, Nakula as the horse keeper Granthika, Sahadeva as the cowherd Tantipala and Draupadi as the maid Sairandhri. The assumed names are alternative labels of each concept."@en ;
    skos:member mbh:yudhishthira, mbh:bhima, mbh:arjuna, mbh:nakula, mbh:sahadeva, mbh:draupadi .
