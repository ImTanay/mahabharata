    skos:definition "Son of Arjuna and Chitrangada, king of Manipura, who killed his father in battle during the horse sacrifice without knowing him; Ulupi revived Arjuna with the Nagas' gem."@en ;
    mbhx:childOf mbh:arjuna, mbh:chitrangada-manipura ;
    skos:exactMatch wd:Q2472921, dbr:Babhruvahana ;
