    skos:hiddenLabel "Lakshman Kumar"@en ;
    skos:definition "Son of Duryodhana, killed by Abhimanyu inside Drona's circular battle formation on day 13."@en ;
    mbhx:childOf mbh:duryodhana ;
    mbhx:killedBy mbh:abhimanyu ;
    mbhx:fellOnWarDay 13 ;
    skos:exactMatch wd:Q6505158, <http://dbpedia.org/resource/Lakshmana_(Mahabharata)> ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Lakshmana_(Mahabharata)> .

mbh:durmasena a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:children-of-the-kauravas ;
    skos:prefLabel "Durmasena"@en ;
    skos:altLabel "Dauhshasani"@en, "दौःशासनि"@sa-Deva, "Dauḥśāsani"@sa-Latn ;
    skos:definition "Son of Dushasana, who struck the final mace blow that killed the exhausted Abhimanyu on day 13; the sons of Draupadi killed him the next day."@en ;
    skos:scopeNote "The epic names him by the patronymic Dauhshasani; Durmasena is the name used in later tradition."@en ;
    mbhx:childOf mbh:dushasana ;
    mbhx:fellOnWarDay 14 ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/List_of_characters_in_the_Mahabharata> .

# 4.6 Consorts of the Pandavas

mbh:draupadi a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:consorts-of-the-pandavas, mbh:panchala ;
    skos:prefLabel "Draupadi"@en, "द्रौपदी"@sa-Deva, "Draupadī"@sa-Latn ;
    skos:altLabel "Krishnaa"@en, "Panchali"@en, "Yajnaseni"@en, "Sairandhri"@en, "Malini"@en, "Parshati"@en, "कृष्णा"@sa-Deva, "पाञ्चाली"@sa-Deva, "Kṛṣṇā"@sa-Latn, "Pāñcālī"@sa-Latn, "Yājñasenī"@sa-Latn ;
    skos:hiddenLabel "Drupadi"@en, "Dropadi"@en, "Draupathi"@en ;
    skos:definition "Daughter of Drupada, born from the sacrificial fire, won by Arjuna at her swayamvara and married to all five Pandavas; her humiliation after the dice game drives the war."@en ;
    skos:note "Krishna made her garment endless when Dushasana tried to strip her. She vowed to leave her hair unbound until the Kauravas were punished. At Virata's court she served the queen as the maid Sairandhri under the name Malini, and Kichaka's pursuit of her cost him his life. Her five sons were killed in the night raid after the war. She was the first to fall on the final journey."@en ;
    mbhx:childOf mbh:drupada ;
    mbhx:spouseOf mbh:yudhishthira, mbh:bhima, mbh:arjuna, mbh:nakula, mbh:sahadeva ;
    skos:exactMatch wd:Q1057886, dbr:Draupadi ;
    foaf:isPrimaryTopicOf wp:Draupadi .

mbh:hidimbi a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:consorts-of-the-pandavas, mbh:rakshasas ;
    skos:prefLabel "Hidimbi"@en, "हिडिम्बा"@sa-Deva, "Hiḍimbā"@sa-Latn ;
    skos:altLabel "Hidimba (rakshasi)"@en ;
    skos:hiddenLabel "Hidimbaa"@en, "Hidimvi"@en ;
    skos:definition "Rakshasa woman, sister of Hidimba, who fell in love with Bhima after the escape from the house of lac, married him and bore Ghatotkacha."@en ;
    mbhx:siblingOf mbh:hidimba ;
    mbhx:spouseOf mbh:bhima ;
    skos:exactMatch wd:Q2472701, dbr:Hidimbi ;
    foaf:isPrimaryTopicOf wp:Hidimbi .

mbh:ulupi a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:consorts-of-the-pandavas, mbh:nagas ;
    skos:prefLabel "Ulupi"@en, "उलूपी"@sa-Deva, "Ulūpī"@sa-Latn ;
    skos:hiddenLabel "Uloopi"@en ;
    skos:definition "Naga princess, daughter of the serpent king Kauravya, who married Arjuna during his pilgrimage and bore Iravan; she later restored Arjuna to life after Babruvahana killed him."@en ;
    mbhx:spouseOf mbh:arjuna ;
    skos:exactMatch wd:Q2723089, dbr:Ulupi ;
    foaf:isPrimaryTopicOf wp:Ulupi .

mbh:chitrangada-manipura a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:consorts-of-the-pandavas, mbh:kingdom-manipura ;
    skos:prefLabel "Chitrangada (princess of Manipura)"@en, "चित्राङ्गदा"@sa-Deva, "Citrāṅgadā"@sa-Latn ;
    skos:definition "Princess of Manipura, daughter of King Chitravahana, who married Arjuna on condition that their son would stay as her father's heir; mother of Babruvahana."@en ;
    skos:scopeNote "Not the son of Shantanu of the same name; see Chitrangada (son of Shantanu)."@en ;
    mbhx:spouseOf mbh:arjuna ;
    skos:exactMatch wd:Q2367305, <http://dbpedia.org/resource/Chitrangada_(princess)> ;
    foaf:isPrimaryTopicOf <https://en.wikipedia.org/wiki/Chitrangada_(princess)> .

mbh:subhadra a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:consorts-of-the-pandavas, mbh:yadavas ;
    skos:prefLabel "Subhadra"@en, "सुभद्रा"@sa-Deva, "Subhadrā"@sa-Latn ;
    skos:definition "Daughter of Vasudeva and sister of Krishna and Balarama, who eloped with Arjuna with Krishna's connivance; mother of Abhimanyu."@en ;
    mbhx:childOf mbh:vasudeva ;
    mbhx:spouseOf mbh:arjuna ;
    skos:exactMatch wd:Q1982348, dbr:Subhadra ;
    foaf:isPrimaryTopicOf wp:Subhadra .

# 4.7 Children of the Pandavas

mbh:abhimanyu a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:children-of-the-pandavas ;
    skos:prefLabel "Abhimanyu"@en, "अभिमन्यु"@sa-Deva, "Abhimanyu"@sa-Latn ;
    skos:altLabel "Saubhadra"@en, "सौभद्र"@sa-Deva, "Saubhadra"@sa-Latn ;
    skos:definition "Son of Arjuna and Subhadra and husband of Uttara of Matsya; at sixteen he broke alone into Drona's circular formation on day 13 and was killed there by many warriors at once, against the rules of war."@en ;
    skos:note "Jayadratha held the other Pandavas outside the formation. Abhimanyu killed Lakshmana Kumara before he fell; the final blow came from Dushasana's son. His posthumous son Parikshit continued the Kuru line."@en ;
    mbhx:childOf mbh:arjuna, mbh:subhadra ;
    mbhx:spouseOf mbh:uttaraa ;
    mbhx:killedBy mbh:durmasena ;
    mbhx:fellOnWarDay 13 ;
    skos:exactMatch wd:Q320606, dbr:Abhimanyu ;
    foaf:isPrimaryTopicOf wp:Abhimanyu .

mbh:ghatotkacha a mbhx:Character, skos:Concept ;
    skos:inScheme mb:characters ;
    skos:broader mbh:children-of-the-pandavas, mbh:rakshasas ;
    skos:prefLabel "Ghatotkacha"@en, "घटोत्कच"@sa-Deva, "Ghaṭotkaca"@sa-Latn ;
    skos:hiddenLabel "Ghatotkach"@en ;
    skos:definition "Rakshasa son of Bhima and Hidimbi, whose night attack on day 14 forced Karna to spend on him the weapon from Indra he had kept for Arjuna."@en ;
    mbhx:childOf mbh:bhima, mbh:hidimbi ;
    mbhx:killedBy mbh:karna ;
    mbhx:fellOnWarDay 14 ;
    skos:exactMatch wd:Q1976196, dbr:Ghatotkacha ;
    foaf:isPrimaryTopicOf wp:Ghatotkacha .

