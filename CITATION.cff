    title: "Mahabharata"
    url: "https://en.wikipedia.org/wiki/Mahabharata"
    publisher:
      name: "Wikipedia, The Free Encyclopedia"
    license: CC-BY-SA-4.0
  - type: standard
    title: "SKOS Simple Knowledge Organization System Reference"
    url: "https://www.w3.org/TR/skos-reference/"
    publisher:
      name: "World Wide Web Consortium"
    date-released: 2009-08-18
